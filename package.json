{
  "name": "forgepilot",
  "version": "0.1.0",
  "description": "Desktop agent workspace for local and hosted LLMs with tool calling, MCP, and document support.",
  "productName": "ForgePilot",
  "author": {
    "name": "ForgePilot",
    "email": "hello@forgepilot.app"
  },
  "homepage": "https://forgepilot.app",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/start-electron.mjs",
    "dev": "node scripts/start-electron.mjs",
    "test": "node --test",
    "test:acceptance": "node --test test/ollama-acceptance.test.js",
    "pack": "electron-builder --dir",
    "build:win": "electron-builder --win portable --publish never",
    "build:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "build:linux": "electron-builder --linux AppImage deb --x64 --publish never"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "electron": "^35.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.forgepilot.desktop",
    "productName": "ForgePilot",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "scripts/**/*",
      "plugins/**/*",
      "package.json",
      "README.md",
      "!test{,/**/*}",
      "!fixtures{,/**/*}",
      "!release{,/**/*}",
      "!dist{,/**/*}",
      "!out{,/**/*}",
      "!build{,/**/*}",
      "!.cokgizlicoder{,/**/*}"
    ],
    "asar": true,
    "asarUnpack": [
      "src/core/tools/document-reader.py"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Development",
      "executableName": "forgepilot",
      "maintainer": "ForgePilot <hello@forgepilot.app>",
      "icon": "build/icons",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
